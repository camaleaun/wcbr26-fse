{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "WordCamp Brasil 2026",
    "author": "camaleaun"
  },
  "landingPage": "/",
  "login": true,
  "preferredVersions": { "php": "8.3", "wp": "latest" },
  "features": { "networking": true },
  "siteOptions": {
    "blogname": "WordCamp Brasil 2026",
    "blogdescription": "Belo Horizonte, 30 e 31 de outubro de 2026"
  },
  "steps": [
    {
      "step": "installTheme",
      "themeData": { "resource": "wordpress.org/themes", "slug": "twentytwentyfive" },
      "options": { "activate": true }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/uploads/wcbr2026"
    },
    {
      "step": "writeFiles",
      "writeToPath": "/wordpress/wp-content/uploads/wcbr2026",
      "filesTree": {
        "resource": "git:directory",
        "url": "https://github.com/camaleaun/wcbr26-fse",
        "ref": "main",
        "refType": "branch",
        "path": "/fse"
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/uploads/wcbr2026/fonts"
    },
    {
      "step": "writeFiles",
      "writeToPath": "/wordpress/wp-content/uploads/wcbr2026/fonts",
      "filesTree": {
        "resource": "git:directory",
        "url": "https://github.com/camaleaun/wcbr26-fse",
        "ref": "main",
        "refType": "branch",
        "path": "/html-from-figma/assets/fonts"
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/uploads/wcbr2026/img"
    },
    {
      "step": "writeFiles",
      "writeToPath": "/wordpress/wp-content/uploads/wcbr2026/img",
      "filesTree": {
        "resource": "git:directory",
        "url": "https://github.com/camaleaun/wcbr26-fse",
        "ref": "main",
        "refType": "branch",
        "path": "/html-from-figma/assets/img"
      }
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/wcbr2026.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/camaleaun/wcbr26-fse/main/fse/mu-plugin.php"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require '/wordpress/wp-content/uploads/wcbr2026/setup.php';"
    },
    {
      "step": "setSiteLanguage",
      "language": "pt_BR"
    }
  ]
}
