{
  "name": "wcbr2026-bootstrap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "css": "sass scss/wcbr.scss assets/css/wcbr.css --style expanded --source-map --silence-deprecation=import,if-function",
    "css-watch": "sass scss/wcbr.scss assets/css/wcbr.css --style expanded --source-map --silence-deprecation=import,if-function --watch",
    "docs-css": "sass site/src/scss/docs.scss assets/css/docs.css --style expanded --source-map --silence-deprecation=import,if-function",
    "docs-css-watch": "sass site/src/scss/docs.scss assets/css/docs.css --style expanded --source-map --silence-deprecation=import,if-function --watch",
    "docs-serve": "ASTRO_DEV_BACKGROUND=1 astro dev --root site --port 4321 --force",
    "docs-build": "astro build --root site",
    "serve": "npx --yes serve . -p 3000",
    "dev": "npm run css-watch & npm run serve",
    "start": "npm run css & npm run docs-css & npm run css-watch & npm run docs-css-watch & npm run docs-serve",
    "build": "npm run css && npm run docs-css && npm run docs-build",
    "i18n-check": "node scripts/i18n-check.js",
    "i18n-sync": "node scripts/i18n-sync.js"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/prism": "^4.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@types/js-yaml": "^4.0.9",
    "astro": "^7.1.6",
    "astro-auto-import": "^0.5.2",
    "bootstrap": "^5.3.3",
    "js-yaml": "^5.2.3",
    "sass": "^1.79.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@docsearch/css": "^4.7.0",
    "@docsearch/js": "^4.7.0",
    "@stackblitz/sdk": "^1.11.1",
    "autoprefixer": "^10.5.4",
    "clipboard": "^2.0.11",
    "htmlparser2": "^12.0.0",
    "image-size": "^2.0.2",
    "mime": "^4.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1"
  }
}
