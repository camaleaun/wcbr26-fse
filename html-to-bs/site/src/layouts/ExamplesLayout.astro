---
import type { HTMLAttributes } from 'astro/types'
import { getVersionedBsJsProps } from '@libs/wcbr'
import { getConfig } from '@libs/config'
import type { ExampleFrontmatter } from '@libs/examples'
import { getVersionedDocsPath } from '@libs/path'
import ExamplesStylesheet from '@components/head/ExamplesStylesheet.astro'
import Favicons from '@components/head/Favicons.astro'
import Icons from '@layouts/partials/Icons.astro'

type Props = ExampleFrontmatter

const { body_class, direction, extra_css, extra_js, html_class, include_js, title = 'Example' } = Astro.props

const pathname = Astro.url.pathname
const isPtBr = pathname.includes('/examples/pt-br/')
const langHref = isPtBr
  ? pathname.replace('/examples/pt-br/', '/examples/')
  : pathname.replace('/examples/', '/examples/pt-br/')

const pageTitle = `${title} · ${getConfig().title} v${getConfig().docs_version}`
const canonicalUrl = new URL(pathname, Astro.site)

const htmlProps: HTMLAttributes<'html'> = direction === 'rtl'
  ? { lang: 'ar', dir: 'rtl' }
  : { lang: isPtBr ? 'pt-BR' : 'en' }
---

<!doctype html>
<html {...htmlProps} class:list={html_class} data-bs-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${title} — WCBR Bootstrap Design System`} />
    <meta name="author" content={getConfig().authors} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>

    <link rel="canonical" href={canonicalUrl} />

    <script is:inline>
      (function () {
        var KEY = 'wcbr-ex-lang';
        var path = location.pathname;
        var inPt = path.indexOf('/examples/pt-br/') !== -1;
        var pref = localStorage.getItem(KEY);
        if (pref === 'en' && inPt) { location.replace(path.replace('/examples/pt-br/', '/examples/')); return; }
        if (pref === 'pt' && !inPt) { location.replace(path.replace('/examples/', '/examples/pt-br/')); return; }
        if (!pref && path.indexOf('/examples/') !== -1 && !inPt) {
          var langs = navigator.languages || [navigator.language || ''];
          var isPt = langs.some(function (l) { return l.toLowerCase().startsWith('pt'); });
          if (isPt) { localStorage.setItem(KEY, 'pt'); location.replace(path.replace('/examples/', '/examples/pt-br/')); }
        }
      })();
    </script>

    <ExamplesStylesheet />
    <Favicons />

    <style is:global>
      .wcbrd-placeholder-img {
        font-size: 1.125rem;
        text-anchor: middle;
        -webkit-user-select: none;
        -moz-user-select: none;
        user-select: none;
      }

      @media (min-width: 768px) {
        .wcbrd-placeholder-img-lg {
          font-size: 3.5rem;
        }
      }

      .b-example-divider {
        width: 100%;
        height: 3rem;
        background-color: rgba(0, 0, 0, 0.1);
        border: solid rgba(0, 0, 0, 0.15);
        border-width: 1px 0;
        box-shadow:
          inset 0 0.5em 1.5em rgba(0, 0, 0, 0.1),
          inset 0 0.125em 0.5em rgba(0, 0, 0, 0.15);
      }

      .b-example-vr {
        flex-shrink: 0;
        width: 1.5rem;
        height: 100vh;
      }

      .bi {
        vertical-align: -0.125em;
        fill: currentColor;
      }

      .nav-scroller {
        position: relative;
        z-index: 2;
        height: 2.75rem;
        overflow-y: hidden;
      }

      .nav-scroller .nav {
        display: flex;
        flex-wrap: nowrap;
        padding-bottom: 1rem;
        margin-top: -1px;
        overflow-x: auto;
        text-align: center;
        white-space: nowrap;
        -webkit-overflow-scrolling: touch;
      }

      .btn-wcbrd-primary {
        --wcbrd-violet-bg: #00595d;
        --wcbrd-violet-rgb: 0, 89, 93;

        --bs-btn-font-weight: 600;
        --bs-btn-color: var(--bs-white);
        --bs-btn-bg: var(--wcbrd-violet-bg);
        --bs-btn-border-color: var(--wcbrd-violet-bg);
        --bs-btn-hover-color: var(--bs-white);
        --bs-btn-hover-bg: #004c4d;
        --bs-btn-hover-border-color: #004c4d;
        --bs-btn-focus-shadow-rgb: var(--wcbrd-violet-rgb);
        --bs-btn-active-color: var(--bs-btn-hover-color);
        --bs-btn-active-bg: #003e3e;
        --bs-btn-active-border-color: #003e3e;
      }

      .wcbrd-mode-toggle {
        z-index: 1500;
      }

      .wcbrd-mode-toggle .bi {
        width: 1em;
        height: 1em;
      }

      .wcbrd-mode-toggle .dropdown-menu .active .bi {
        display: block !important;
      }

      .ex-lang-switcher {
        position: fixed;
        top: 0.75rem;
        right: 0.75rem;
        z-index: 9999;
        display: flex;
        align-items: center;
        gap: 0.125rem;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        border-radius: 2rem;
        padding: 0.1875rem 0.375rem;
      }
      .ex-lang-btn {
        font-size: 0.625rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        padding: 0.2rem 0.5rem;
        border-radius: 2rem;
        text-decoration: none;
        color: rgba(255, 255, 255, 0.55);
        line-height: 1.4;
      }
      .ex-lang-active {
        background: rgba(255, 255, 255, 0.15);
        color: #fff;
      }
      .ex-lang-btn:not(.ex-lang-active):hover { color: #fff; }
    </style>

    {extra_css?.map((extraCss) => <link href={extraCss} rel="stylesheet" />)}
  </head>
  <body class:list={body_class}>
    <Icons />

    <nav class="ex-lang-switcher" aria-label="Language">
      {isPtBr ? (
        <>
          <a href={langHref} class="ex-lang-btn" data-lang-switch="en">EN</a>
          <span class="ex-lang-btn ex-lang-active" aria-current="page">PT-BR</span>
        </>
      ) : (
        <>
          <span class="ex-lang-btn ex-lang-active" aria-current="page">EN</span>
          <a href={langHref} class="ex-lang-btn" data-lang-switch="pt">PT-BR</a>
        </>
      )}
    </nav>

    <slot />

    <script is:inline>
      document.querySelectorAll('[data-lang-switch]').forEach(function (el) {
        el.addEventListener('click', function () {
          localStorage.setItem('wcbr-ex-lang', this.dataset.langSwitch);
        });
      });
    </script>

    {
      include_js !== false && (
        <Fragment>
          <script is:inline {...getVersionedBsJsProps()} />
          {extra_js?.map((js) => (
            <script
              is:inline
              async={js.async}
              src={js.src}
              integrity={js.integrity}
              {...(js.integrity && { crossorigin: 'anonymous' })}
            />
          ))}
        </Fragment>
      )
    }
  </body>
</html>
