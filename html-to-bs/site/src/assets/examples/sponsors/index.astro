---
export const title = 'Sponsors'
export const body_class = 'bg-body'
---

<section class="sponsors section" id="patrocinadores" aria-labelledby="sponsors-title">
      <div class="container">
        <div class="section-head">
          <h2 id="sponsors-title" >Our sponsors</h2>
        </div>

        <h3 class="tier">Tropeirão Sponsorship (Gold)</h3>
        <div class="row row-cols-2 row-cols-sm-4 sponsor-grid">
          <div class="col"><div class="sponsor sponsor-lg"><span class="sponsor-icon"><svg class="icon" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M12 3 3 20h18L12 3Z"/></svg></span>TechNova</div></div>
          <div class="col"><div class="sponsor sponsor-lg"><span class="sponsor-icon"><svg class="icon" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>CloudSphere</div></div>
          <div class="col"><div class="sponsor sponsor-lg"><span class="sponsor-icon"><svg class="icon" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><rect x="4" y="4" width="16" height="16"/></svg></span>DataCore</div></div>
          <div class="col"><div class="sponsor sponsor-lg"><span class="sponsor-icon"><svg class="icon" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M12 4 4 19h16L12 4Z"/><path d="M9 19l3-6 3 6"/></svg></span>Summit Systems</div></div>
        </div>

        <h3 class="tier">Torresmo de Rolo Sponsorship (Silver)</h3>
        <div class="row row-cols-3 row-cols-sm-6 sponsor-grid">
          <div class="col"><div class="sponsor"><span class="sponsor-icon"><svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8Z"/></svg></span></div></div>
          <div class="col"><div class="sponsor"><span class="sponsor-icon"><svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M12 4 5 8v4l7 4 7-4V8l-7-4Z"/></svg></span></div></div>
          <div class="col"><div class="sponsor"><span class="sponsor-icon"><svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><circle cx="12" cy="12" r="8"/></svg></span></div></div>
          <div class="col"><div class="sponsor"><span class="sponsor-icon"><svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="m12 3 2.5 6H21l-5 4 2 7-6-4-6 4 2-7-5-4h6.5L12 3Z"/></svg></span></div></div>
          <div class="col"><div class="sponsor"><span class="sponsor-icon"><svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M12 5 6 8v4l6 3 6-3V8l-6-3Z"/></svg></span></div></div>
          <div class="col"><div class="sponsor"><span class="sponsor-icon"><svg class="icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M12 20s-7-4.5-7-9.5A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 7 3.5C19 15.5 12 20 12 20Z"/></svg></span></div></div>
        </div>

        <h3 class="tier tier-sm">Pão de Queijo Sponsorship (Bronze)</h3>
        <div class="row row-cols-2 sponsor-grid sponsor-grid-sm mx-auto">
          <div class="col"><div class="sponsor sponsor-text">PixelPerfect</div></div>
          <div class="col"><div class="sponsor sponsor-text">Webflow Pro</div></div>
        </div>

        <h3 class="tier tier-sm">Cafezinho Sponsorship (Iron)</h3>
        <div class="row row-cols-2 sponsor-grid sponsor-grid-sm mx-auto">
          <div class="col"><div class="sponsor sponsor-text">DevLocal</div></div>
          <div class="col"><div class="sponsor sponsor-text">CodeMinds</div></div>
        </div>

        <div class="micro-sponsor">
          <h3 class="micro-sponsor-title">Micro-sponsorship: Broa de Milho</h3>
          <p class="micro-sponsor-names">João Silva, Maria Oliveira, Carlos Santos, Ana Costa, Pedro Rocha</p>
        </div>

        <p class="text-center mt-5 mb-0"><a class="link-under" href="#">View all sponsors<svg class="icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></p>
        <p class="text-center mt-4 mb-0"><a class="btn btn-orange" href="#">Become a sponsor</a></p>
      </div>
    </section>
