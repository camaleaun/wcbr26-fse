---
export const title = 'Newsletter'
export const body_class = 'bg-body'
---

<section class="newsletter section" aria-labelledby="signup-title">
      <div class="container newsletter-inner text-center">
            <h2 id="signup-title" class="newsletter-title">Stay up to date</h2>
            <p class="newsletter-lead">Subscribe to our newsletter and be the first to hear about ticket sales, confirmed speakers, and the full schedule.</p>
            <form class="newsletter-form d-flex flex-column flex-sm-row gap-3" action="#" method="post" novalidate>
              <label class="visually-hidden" for="email">Your best email</label>
              <input class="form-control" type="email" id="email" name="email" placeholder="Your best email" autocomplete="email" required>
              <button class="btn btn-orange" type="submit">Subscribe</button>
            </form>
      </div>
    </section>
