---
export const title = 'Hero'
export const body_class = 'bg-body'
---

<section class="hero" aria-labelledby="hero-title">
      <div class="container">
        <div class="hero-grid">
          <div>
            <div class="hero-meta d-flex flex-wrap gap-3">
              <span class="badge text-bg-primary">
                <svg class="icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M7 2v3M17 2v3M3 8h18M4 5h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/></svg>
                30 e 31 outubro 2026
              </span>
              <span class="badge text-bg-orange">
                <svg class="icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                Belo Horizonte MG • FUMEC
              </span>
            </div>
            <h1 id="hero-title" class="hero-title">Bem-vindo ao<br>WordCamp Brasil</h1>
            <p class="hero-lead">A maior conferência WordPress da América Latina desembarca na capital mineira em 2026. Junte-se a nós para dois dias de aprendizado, networking e inovação.</p>
            <a class="btn btn-orange" href="#">Garanta seu ingresso</a>
          </div>
          <div class="hero-media">
            <div class="hero-frame">
              <picture>
                <source type="image/avif" srcset="/docs/2026/assets/img/hero.avif">
                <source type="image/webp" srcset="/docs/2026/assets/img/hero.webp">
                <img src="/docs/2026/assets/img/hero.jpg" alt="Vista panorâmica de Belo Horizonte, sede do WordCamp Brasil 2026" width="512" height="512" fetchpriority="high" class="img-fluid">
              </picture>
            </div>
            </div>
          </div>
      </div>
    </section>
