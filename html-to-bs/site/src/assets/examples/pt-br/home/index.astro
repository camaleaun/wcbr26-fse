  <div class="offcanvas-header">
    <span class="offcanvas-title">Menu</span>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Fechar menu"></button>
  </div>
  <div class="offcanvas-body d-flex flex-column">
    <nav aria-label="Navegação mobile">
      <ul class="list-unstyled drawer-nav">
        <li><a class="drawer-link active" href="#" aria-current="page">
          <img src="/docs/2026/assets/img/icons/nav-inicio.svg" alt="" width="16" height="18" loading="lazy"> Início
        </a></li>
        <li>
          <button class="drawer-link" type="button"
