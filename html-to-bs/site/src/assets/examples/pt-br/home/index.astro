            <img src="/docs/2026/assets/img/icons/nav-chamadas.svg" alt="" width="22" height="19" loading="lazy">
            <span>Chamadas</span>
            <svg class="drawer-caret ms-auto" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5l5-5"/></svg>
          </button>
          <div class="collapse" id="dsub-chamadas">
