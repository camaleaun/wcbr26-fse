---
export const title = 'Home'
export const body_class = 'bg-body'
---

<a class="visually-hidden-focusable" href="#conteudo">Pular para o conteúdo</a>

<!-- ============ HEADER ============ -->
<header class="site-header sticky-top border-bottom">
