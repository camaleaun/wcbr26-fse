          <a class="nav-link dropdown-toggle" href="#sobre" data-bs-toggle="dropdown" aria-expanded="false">Evento <svg class="icon nav-caret" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></a>
