---
export const title = 'Newsletter'
export const body_class = 'bg-body'
---

<section class="newsletter section" aria-labelledby="signup-title">
      <div class="container newsletter-inner text-center">
            <h2 id="signup-title" class="newsletter-title">Fique por dentro das novidades</h2>
            <p class="newsletter-lead">Inscreva-se na nossa newsletter para receber em primeira mão avisos sobre abertura de ingressos, palestrantes confirmados e programação.</p>
            <form class="newsletter-form d-flex flex-column flex-sm-row gap-3 mx-auto" action="#" method="post" novalidate>
              <label class="visually-hidden" for="email">Seu melhor e-mail</label>
              <input class="form-control" type="email" id="email" name="email" placeholder="Seu melhor e-mail" autocomplete="email" required>
              <button class="btn btn-orange" type="submit">Inscrever</button>
            </form>
      </div>
    </section>
