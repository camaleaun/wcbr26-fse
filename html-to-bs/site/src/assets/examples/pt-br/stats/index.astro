---
export const title = 'Stats'
export const body_class = 'bg-body'
---

<section class="stats" aria-label="Números do evento">
      <div class="container">
        <div class="row row-cols-2 row-cols-sm-4 stats-grid text-center">
          <div class="col"><span class="stat-number d-block">100+</span><span class="stat-label d-block">Participantes</span></div>
          <div class="col"><span class="stat-number d-block">16+</span><span class="stat-label d-block">Palestras</span></div>
          <div class="col"><span class="stat-number d-block">15+</span><span class="stat-label d-block">Patrocinadores</span></div>
          <div class="col"><span class="stat-number d-block">2</span><span class="stat-label d-block">Dias de evento</span></div>
        </div>
      </div>
    </section>
