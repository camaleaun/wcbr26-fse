---
export const title = 'About'
export const body_class = 'bg-body'
---

<section class="about section" id="sobre" aria-labelledby="about-title">
      <div class="container">
        <div class="row align-items-center about-grid">
          <div class="col-md-6">
            <div class="about-media">
              <picture>
                <source type="image/avif" srcset="/docs/2026/assets/img/about.avif">
                <source type="image/webp" srcset="/docs/2026/assets/img/about.webp">
                <img src="/docs/2026/assets/img/about.jpg" alt="Professionals gathered at a table during a WordCamp edition" width="584" height="428" loading="lazy" class="img-fluid">
              </picture>
            </div>
          </div>
          <div class="col-md-6 about-text">
            <h2 id="about-title" class="about-title">About WordCamp Brasil</h2>
            <p>WordCamp Brasil is the official event of the WordPress community in Brazil. We bring together developers, designers, content creators, marketing professionals, and enthusiasts to share knowledge and strengthen the WordPress ecosystem in the country.</p>
            <p>In 2026, we chose the vibrant Belo Horizonte and the prestigious FUMEC campus as the stage for a historic edition, focused on accessibility, artificial intelligence, and the future of the open web.</p>
            <a class="link-under" href="#">Discover our history <svg class="icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          </div>
        </div>
      </div>
    </section>
