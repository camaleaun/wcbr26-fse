---
export const title = 'Stats'
export const body_class = 'bg-body'
---

<section class="stats" aria-label="Event numbers">
      <div class="container">
        <div class="row row-cols-2 row-cols-sm-4 stats-grid text-center">
          <div class="col"><span class="stat-number d-block">100+</span><span class="stat-label d-block">Attendees</span></div>
          <div class="col"><span class="stat-number d-block">16+</span><span class="stat-label d-block">Talks</span></div>
          <div class="col"><span class="stat-number d-block">15+</span><span class="stat-label d-block">Sponsors</span></div>
          <div class="col"><span class="stat-number d-block">2</span><span class="stat-label d-block">Event days</span></div>
        </div>
      </div>
    </section>
