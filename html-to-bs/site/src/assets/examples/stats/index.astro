---
export const title = 'Stats'
export const body_class = 'bg-body'
---

<section class="stats" aria-label="Event numbers">
      <div class="container">
        <div class="row row-cols-2 row-cols-sm-4 stats-grid text-center">
          <div class="col"><span class="stat-number d-block text-white">100+</span><span class="stat-label d-block text-white text-uppercase">Attendees</span></div>
          <div class="col"><span class="stat-number d-block text-white">16+</span><span class="stat-label d-block text-white text-uppercase">Talks</span></div>
          <div class="col"><span class="stat-number d-block text-white">15+</span><span class="stat-label d-block text-white text-uppercase">Sponsors</span></div>
          <div class="col"><span class="stat-number d-block text-white">2</span><span class="stat-label d-block text-white text-uppercase">Event days</span></div>
        </div>
      </div>
    </section>
