---
import BaseLayout from '@layouts/BaseLayout.astro'
import { icons } from '../../data/icons'

export function getStaticPaths() {
  return icons.map((icon) => ({
    params: { name: icon.name },
    props: { icon },
  }))
}

const { icon } = Astro.props
const svgSnippet = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor">\n  <!-- paste path here -->\n</svg>`
---

<BaseLayout title={icon.title}>
  <main class="container wcbri-examples" id="content">

    <nav aria-label="breadcrumb">
      <ol class="breadcrumb my-4 p-0">
        <li class="breadcrumb-item"><a href="/icons/">Icons</a></li>
        <li class="breadcrumb-item active" aria-current="page">{icon.title}</li>
      </ol>
    </nav>

    <div class="row align-items-md-center mb-4">
      <div class="col-md-6 col-lg-8">
        <h1>{icon.title}</h1>
        {(icon.tags.length > 0 || icon.categories.length > 0) && (
          <ul class="list-unstyled mb-3 mb-md-0">
            {icon.tags.length > 0 && <li><strong>Tags:</strong> {icon.tags.join(', ')}</li>}
            {icon.categories.length > 0 && <li><strong>Category:</strong> {icon.categories.join(', ')}</li>}
          </ul>
        )}
      </div>
      <div class="col-md-6 col-lg-4"></div>
    </div>

    <hr class="my-4">

    <div class="row gx-lg-5">
      <div class="col-lg-8 mb-4">
        <div class="wcbri-icon-demo mb-4 border rounded-3 d-flex align-items-center justify-content-center p-3"
             style="font-size: 10em;" role="img" aria-label={`${icon.title} large preview`}>
          <Fragment set:html={icon.svg} />
        </div>

        <h2>Examples</h2>
        <div class="p-3 p-md-4 border rounded-3">
          <div class="fs-2 mb-3">
            <Fragment set:html={icon.svg} />
            Heading
          </div>
          <div class="fs-4 mb-3">
            <Fragment set:html={icon.svg} />
            Smaller heading
          </div>
          <p>
            Inline text <Fragment set:html={icon.svg} />
          </p>
          <p>
            <a href="#" class="text-decoration-none">
              Example link <Fragment set:html={icon.svg} />
            </a>
          </p>
          <div class="d-flex gap-2 mb-3">
            <button type="button" class="btn btn-primary">
              <Fragment set:html={icon.svg} />
              Button
            </button>
            <button type="button" class="btn btn-success">
              <Fragment set:html={icon.svg} />
              Button
            </button>
            <button type="button" class="btn btn-outline-danger">
              <Fragment set:html={icon.svg} />
              Button
            </button>
          </div>
          <div class="col-md-6">
            <div class="input-group">
              <span class="input-group-text">
                <Fragment set:html={icon.svg} />
              </span>
              <input type="text" class="form-control" placeholder="Input group example">
            </div>
          </div>
        </div>
      </div>

      <div class="col-lg-4 mb-4">
        <h2 class="fs-3">Download</h2>
        <p>Download the SVG to use or edit.</p>
        <a href={`/icons/${icon.name}.svg`} class="btn btn-primary mb-4" download>Download SVG</a>

        <h2 class="fs-3">Copy SVG</h2>
        <p>Paste the SVG right into your project.</p>
        <div id="copy-error-callout" class="alert alert-info d-none" role="alert"></div>
        <div class="bd-clipboard">
          <button type="button" class="btn-clipboard" title="Copy to clipboard">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
              <path d="M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z"/>
              <path d="M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z"/>
            </svg>
          </button>
        </div>
        <div class="highlight">
          <pre><code class="language-html" id="svg-code">{icon.svg}</code></pre>
        </div>
      </div>
    </div>

  </main>
</BaseLayout>

<style is:global>
  .wcbri-icon-demo svg {
    width: 1em;
    height: 1em;
  }

  .wcbri-examples .highlight {
    position: relative;
    background-color: var(--bs-tertiary-bg);
    border-radius: 0.375rem;
  }

  .wcbri-examples .highlight pre {
    padding: 1rem;
    margin-bottom: 0;
    overflow-x: auto;
    font-size: 0.875em;
  }

  .wcbri-examples .bd-clipboard {
    position: relative;
  }

  .wcbri-examples .btn-clipboard {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 10;
    padding: 0.25rem 0.5rem;
    background: transparent;
    border: 1px solid var(--bs-border-color);
    border-radius: 0.25rem;
    cursor: pointer;
    color: var(--bs-secondary-color);
  }

  .wcbri-examples .btn-clipboard:hover {
    color: var(--bs-body-color);
    background-color: var(--bs-secondary-bg);
  }
</style>

<script>
  import ClipboardJS from 'clipboard'

  const clipboard = new ClipboardJS('.btn-clipboard', {
    target: () => document.querySelector('#svg-code')!,
  })

  clipboard.on('success', (e) => {
    const btn = e.trigger as HTMLButtonElement
    btn.title = 'Copied!'
    e.clearSelection()
    setTimeout(() => { btn.title = 'Copy to clipboard' }, 2000)
  })
</script>
