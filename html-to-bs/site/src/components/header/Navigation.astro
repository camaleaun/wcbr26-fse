---
import type { CollectionEntry } from 'astro:content'
import { getConfig } from '@libs/config'
import { getVersionedDocsPath } from '@libs/path'
import type { Layout } from '@libs/layout'
import WcbrWhiteFillIcon from '@components/icons/WcbrWhiteFillIcon.astro'
import GitHubIcon from '@components/icons/GitHubIcon.astro'
import HamburgerIcon from '@components/icons/HamburgerIcon.astro'
import LinkItem from '@components/header/LinkItem.astro'
import OpenCollectiveIcon from '@components/icons/OpenCollectiveIcon.astro'
import XIcon from '@components/icons/XIcon.astro'
import Versions from '@components/header/Versions.astro'
import ThemeToggler from '@layouts/partials/ThemeToggler.astro'

interface Props {
  addedIn?: CollectionEntry<'docs'>['data']['added']
  layout: Layout
  title: string
}

const { addedIn, layout, title } = Astro.props

const pathname = Astro.url.pathname
const isPtBrDoc = pathname.includes('/pt-br/')
const isTranslatable = /\/docs\/\d+\/(components|content|templates)\//.test(pathname)

const langItems = [
  {
    code: 'en',
    short: 'EN',
    label: 'English',
    isCurrent: !isPtBrDoc,
    href: isPtBrDoc ? pathname.replace('/pt-br/', '/') : undefined,
    isAvailable: true,
  },
  {
    code: 'pt-br',
    short: 'PT-BR',
    label: 'Português (Brasil)',
    isCurrent: isPtBrDoc,
    href: !isPtBrDoc && isTranslatable ? pathname.replace(/(\/docs\/\d+\/)/, '$1pt-br/') : undefined,
    isAvailable: isPtBrDoc || isTranslatable,
  },
  // To add Spanish: { code: 'es', short: 'ES', label: 'Español', isCurrent: false, href: undefined, isAvailable: false }
]

const currentLang = langItems.find((l) => l.isCurrent)!
const hasLangAlternative = langItems.some((l) => !l.isCurrent && l.isAvailable)
---

<header class="navbar navbar-expand-lg wcbrd-navbar sticky-top">
  <nav class="container-xxl wcbrd-gutter flex-wrap flex-lg-nowrap" aria-label="Main navigation">
    {
      layout === 'docs' && (
        <div class="wcbrd-navbar-toggle">
          <button
            class="navbar-toggler p-2"
            type="button"
            data-bs-toggle="offcanvas"
            data-bs-target="#wcbrdSidebar"
            aria-controls="wcbrdSidebar"
            aria-label="Toggle docs navigation"
          >
            <HamburgerIcon class="bi" height={24} width={24} />
            <span class="d-none fs-6 pe-1">Browse</span>
          </button>
        </div>
      )
    }
    {layout !== 'docs' && <div class="d-lg-none" style="width: 4.25rem;" />}

    <a class="navbar-brand p-0 me-0 me-lg-2" href="/" aria-label="WCBR">
      <WcbrWhiteFillIcon class="d-block my-1" height={32} width={31} />
    </a>

    <div class="d-flex">
      <div class="wcbrd-search" id="docsearch" data-wcbrd-docs-version={getConfig().docs_version}></div>

      <button
        class="navbar-toggler d-flex d-lg-none order-3 p-2"
        type="button"
        data-bs-toggle="offcanvas"
        data-bs-target="#wcbrdNavbar"
        aria-controls="wcbrdNavbar"
        aria-label="Toggle navigation"
      >
        <svg class="bi" aria-hidden="true"><use xlink:href="#three-dots"></use></svg>
      </button>
    </div>

    <div
      class="offcanvas-lg offcanvas-end flex-grow-1"
      tabindex="-1"
      id="wcbrdNavbar"
      aria-labelledby="wcbrdNavbarOffcanvasLabel"
    >
      <div class="offcanvas-header px-4 pb-0">
        <h5 class="offcanvas-title text-white" id="wcbrdNavbarOffcanvasLabel">WCBR</h5>
        <button
          type="button"
          class="btn-close btn-close-white"
          data-bs-dismiss="offcanvas"
          aria-label="Close"
          data-bs-target="#wcbrdNavbar"></button>
      </div>

      <div class="offcanvas-body p-4 pt-0 p-lg-0">
        <hr class="d-lg-none text-white-50" />
        <ul class="navbar-nav flex-row flex-wrap wcbrd-navbar-nav">
          <LinkItem active={layout === 'docs'} href={getVersionedDocsPath('getting-started/introduction/')} track>
            Docs
          </LinkItem>
          <LinkItem active={layout === 'examples'} href={getVersionedDocsPath('examples/')}>
            Examples
          </LinkItem>
          <LinkItem active={pathname.startsWith('/icons')} href="/icons/">
            Icons
          </LinkItem>
        </ul>

        <hr class="d-lg-none text-white-50" />

        <ul class="navbar-nav flex-row flex-wrap ms-md-auto">
          <LinkItem class="nav-link py-2 px-0 px-lg-2" href={getConfig().github_org} target="_blank" rel="noopener">
            <GitHubIcon class="navbar-nav-svg" height={16} width={16} />
            <small class="d-lg-none ms-2">GitHub</small>
          </LinkItem>
          <LinkItem
            class="nav-link py-2 px-0 px-lg-2"
            href={`https://x.com/${getConfig().x}`}
            target="_blank"
            rel="noopener"
          >
            <XIcon class="navbar-nav-svg" height={16} width={16} />
            <small class="d-lg-none ms-2">X</small>
          </LinkItem>
          <li class="nav-item py-2 py-lg-1 col-12 col-lg-auto">
            <div class="vr d-none d-lg-flex h-100 mx-lg-2 text-white"></div>
            <hr class="d-lg-none my-2 text-white-50" />
          </li>

          {hasLangAlternative ? (
          <li class="nav-item dropdown">
            <button
              type="button"
              class="btn btn-link nav-link py-2 px-0 px-lg-2 dropdown-toggle"
              data-bs-toggle="dropdown"
              aria-expanded="false"
              data-bs-display="static"
            >
              {currentLang.short}
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              {langItems.map((lang) => (
                <li>
                  {lang.isCurrent ? (
                    <span class="dropdown-item d-flex align-items-center justify-content-between active" aria-current="true">
                      {lang.label}
                      <svg class="bi ms-2" aria-hidden="true"><use xlink:href="#check2"></use></svg>
                    </span>
                  ) : lang.isAvailable ? (
                    <a class="dropdown-item" href={lang.href} data-lang-switch={lang.code}>
                      {lang.label}
                    </a>
                  ) : (
                    <span class="dropdown-item disabled" aria-disabled="true">{lang.label}</span>
                  )}
                </li>
              ))}
            </ul>
          </li>
          ) : (
          <li class="nav-item py-2 py-lg-1 col-12 col-lg-auto">
            <span class="nav-link px-0 px-lg-2" style="opacity:.55;cursor:default">{currentLang.short}</span>
          </li>
          )}

          <Versions layout={layout} addedIn={addedIn} />

          <li class="nav-item py-2 py-lg-1 col-12 col-lg-auto wcbrd-theme-divider">
            <div class="vr d-none d-lg-flex h-100 mx-lg-2 text-white"></div>
            <hr class="d-lg-none my-2 text-white-50" />
          </li>

          <li class="nav-item dropdown">
            <ThemeToggler layout={layout} />
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>


<script>
  document.querySelectorAll<HTMLElement>('[data-lang-switch]').forEach((el) => {
    el.addEventListener('click', () => {
      localStorage.setItem('wcbr-docs-lang', el.dataset.langSwitch!)
    })
  })
</script>
