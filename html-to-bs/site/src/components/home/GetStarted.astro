---
import { getConfig } from '@libs/config'
import { getVersionedDocsPath } from '@libs/path'
import Code from '@shortcodes/Code.astro'
---

<div class="col-lg-7 mx-auto pb-3 mb-3 mb-md-5 text-md-center">
  <div class="masthead-followup-icon d-inline-block mb-3" style="--bg-rgb: var(--bd-cyan-rgb);">
    <svg class="bi fs-1" aria-hidden="true"><use xlink:href="#code"></use></svg>
  </div>
  <h2 class="display-5 mb-3 fw-semibold lh-sm">Get started with WCBR</h2>
  <p class="lead fw-normal">
    Include the compiled CSS and Bootstrap JS, or build from the Sass source with our custom overrides.
  </p>
  <p class="d-flex justify-content-md-center lead fw-normal">
    <a href={getVersionedDocsPath('getting-started/introduction/')} class="icon-link icon-link-hover fw-semibold ps-md-4">
      Read the introduction
      <svg class="bi" aria-hidden="true"><use xlink:href="#arrow-right"></use></svg>
    </a>
  </p>
</div>

<section class="row g-3 g-md-5 mb-5 pb-5 justify-content-center">
  <div class="col-lg-6 py-lg-4 pe-lg-5">
    <svg class="bi mb-2 fs-2 text-body-secondary" aria-hidden="true"><use xlink:href="#filetype-css"></use></svg>
    <h3 class="fw-semibold">Include compiled CSS</h3>
    <p class="pe-lg-5">
      Link the WCBR compiled stylesheet and Bootstrap's JS bundle. The CSS already includes all Bootstrap
      base styles and the full WCBR color and component overrides.
    </p>
    <Code
      code={`<link href="wcbr.css" rel="stylesheet">\n<script src="${getConfig().cdn.js_bundle}" integrity="${getConfig().cdn.js_bundle_hash}" crossorigin="anonymous"></script>`}
      lang="html"
    />
  </div>
  <div class="col-lg-6 py-lg-4 ps-lg-5 border-lg-start">
    <svg class="bi mb-2 fs-2 text-body-secondary" aria-hidden="true"><use xlink:href="#box-seam"></use></svg>
    <h3 class="fw-semibold">Build from Sass source</h3>
    <p class="pe-lg-5">
      Clone the repo and compile the WCBR theme from its Sass source. The entry point is
      <code>html-to-bs/scss/wcbr.scss</code> — it imports Bootstrap and applies WCBR variable overrides.
    </p>
    <Code code={`git clone ${getConfig().repo}\ncd wcbr2026/html-to-bs\nnpm install\nnpm run css`} lang="sh" />
    <p>
      The compiled output lands in <code>assets/css/wcbr.css</code>. See <a href={getVersionedDocsPath('customize/color')}>Customize &rsaquo; Color</a> for the token reference.
    </p>
  </div>
</section>
