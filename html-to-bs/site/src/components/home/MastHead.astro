---
import { getConfig } from '@libs/config'
import { getVersionedDocsPath } from '@libs/path'
import WcbrWhiteFillIcon from '@components/icons/WcbrWhiteFillIcon.astro'
---

<div class="bd-masthead mb-3" id="content">
  <div class="container-xxl bd-gutter">
    <div class="col-md-8 mx-auto text-center">
      <WcbrWhiteFillIcon class="d-block mx-auto mb-4" height={80} width={78} />
      <h1 class="mb-3 fw-semibold lh-1">WCBR2026<br>Design System</h1>
      <p class="lead mb-4">
        Bootstrap 5-based design system for WordCamp Brasil 2026 — custom color palette,
        typography, and components built from the Figma prototype.
      </p>
      <div class="d-flex flex-column flex-lg-row align-items-md-stretch justify-content-md-center gap-3 mb-4">
        <a
          href={getVersionedDocsPath('getting-started/introduction')}
          class="btn btn-lg bd-btn-lg btn-bd-primary d-flex align-items-center justify-content-center fw-semibold"
        >
          <svg class="bi me-2" aria-hidden="true"><use xlink:href="#book-half"></use></svg>
          Read the docs
        </a>
        <a
          href={getVersionedDocsPath('templates/home')}
          class="btn btn-lg bd-btn-lg btn-outline-secondary d-flex align-items-center justify-content-center fw-semibold"
        >
          <svg class="bi me-2" aria-hidden="true"><use xlink:href="#layout-text-window"></use></svg>
          Home template
        </a>
      </div>
      <p class="text-body-secondary mb-0">
        Currently <strong>v{getConfig().current_version}</strong>
        <span class="px-1">&middot;</span>
        <a href={getConfig().github_org} class="link-secondary" target="_blank" rel="noopener">GitHub</a>
      </p>
    </div>
  </div>
</div>
