{
	auto_https off
	admin off
}
https://localhost:8444 {
	root * /srv
	encode zstd gzip

	# redireciona raiz para base do Astro
	redir / /docs/2026/ 301

	# ScssProd compila com path ../../../../fonts/ → rewrite para local correto
	@fonts path /fonts/*
	rewrite @fonts /docs/2026/assets{uri}

	# assets com hash de conteúdo (Astro _astro/) → imutáveis
	@immutable path /docs/2026/_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# imagens e fontes pré-geradas → cache de 1 semana
	@static path /docs/2026/assets/img/* /docs/2026/assets/fonts/*
	header @static Cache-Control "public, max-age=604800"

	# HTML → sempre revalidar
	@html {
		path *.html
	}
	header @html Cache-Control "no-cache"

	tls /certs/localhost.pem /certs/localhost-key.pem
	file_server
}
